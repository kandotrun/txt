<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Associated Domains (spec §13): the same RP ID as the Web client and the
		macOS app, so a passkey created anywhere unlocks everywhere.
	-->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:txt.2-38.com</string>
	</array>
</dict>
</plist>
