# Security and caching policy for static assets served by the ASSETS binding.
#
# Cloudflare's asset layer applies these headers itself, so they survive even if
# a CDN cache entry is served instead of the Worker response. The Worker also
# sets them (spec §14); this file guarantees the static surface matches.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob:; media-src 'self' blob:; connect-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'

# The shell and the service worker must never be cached for long: an update has
# to reach users promptly, and the SW checks for its own updates.
/
  Cache-Control: no-store
/index.html
  Cache-Control: no-store
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

# Hashed bundles are immutable.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
