# Security and caching policy for static assets served by the ASSETS binding.
#
# Cloudflare's asset layer applies these headers itself, so they survive even if
# a CDN cache entry is served instead of the Worker response. The Worker sets
# the same values on everything it answers (spec §14).
#
# This file is a template: the build replaces the double-underscore placeholders
# with the values from apps/worker/src/security-headers.ts, so the static surface
# and the Worker cannot drift.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Strict-Transport-Security: __STRICT_TRANSPORT_SECURITY__
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: __PERMISSIONS_POLICY__
  Content-Security-Policy: __SHELL_CSP__

# The shell and the service worker must never be cached for long: an update has
# to reach users promptly, and the SW checks for its own updates. Nothing here
# may be embedded by another origin.
/
  Cache-Control: no-store
  Cross-Origin-Resource-Policy: same-origin
/index.html
  Cache-Control: no-store
  Cross-Origin-Resource-Policy: same-origin
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /
  Cross-Origin-Resource-Policy: same-origin
/styles.css
  Cross-Origin-Resource-Policy: same-origin
/manifest.webmanifest
  Cross-Origin-Resource-Policy: same-origin

# Share card and crawler files: stable names, so cache for a bounded time. These
# are the only files other sites are meant to embed (link previews, home-screen
# icons), so they carry no same-origin resource policy.
/og.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/robots.txt
  Cache-Control: public, max-age=3600

# Hashed bundles are immutable.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: same-origin
